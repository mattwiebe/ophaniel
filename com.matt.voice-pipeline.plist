<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.matt.voice-pipeline</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/php</string>
    <string>/Users/matt/bin/transcribe/voice-pipeline.php</string>
    <string>run-once</string>
    <string>--quiet</string>
  </array>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/matt/bin/transcribe/voice-pipeline.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/matt/bin/transcribe/voice-pipeline.stderr.log</string>
</dict>
</plist>
