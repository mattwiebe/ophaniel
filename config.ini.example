; Voice Pipeline configuration
; Copy this file to config.ini and adjust paths for your machine.

; Core paths
SOURCE_DIRECTORY = "/Users/you/Library/Mobile Documents/iCloud~com~openplanetsoftware~just-press-record/Documents"
TARGET_DIRECTORY = "/Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents/Your Vault/Voice Memos"
; Optional: leave blank to default to TARGET_DIRECTORY + "/audio"
TARGET_AUDIO_DIRECTORY = ""

; Optional state/log paths
STATE_FILE = "/Users/you/bin/transcribe/.voice-pipeline-state.json"
LOCK_FILE = "/Users/you/bin/transcribe/.voice-pipeline.lock"
LOG_FILE = "/Users/you/bin/transcribe/voice-pipeline.log"
; Optional: leave blank to default to SOURCE_DIRECTORY + "/.processed"
LEGACY_PROCESSED_FILE = ""

; Lightning Whisper runtime
LIGHTNING_UV_COMMAND = "/opt/homebrew/bin/uv"
LIGHTNING_SCRIPT = "/Users/you/bin/transcribe/lightning_whisper_test.py"
LIGHTNING_MODEL = "distil-large-v3"
LIGHTNING_BATCH_SIZE = 1
LIGHTNING_LANGUAGE = "en"

; Pipeline behavior
FILE_SETTLE_SECONDS = 20
TEST_OUTPUT_ROOT = "/tmp/transcribe-tests"

; Local LLM metadata generation
ENABLE_LLM_SUMMARY = true
LLM_MODEL = "lmstudio/qwen3-4b-instruct-2507-mlx"
LMS_COMMAND = "/Users/you/.cache/lm-studio/bin/lms"
LMSTUDIO_BASE_URL = "http://127.0.0.1:1234/v1"
LMSTUDIO_API_KEY = "lm-studio"
LMSTUDIO_TIMEOUT_SECONDS = 120
